---
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Jhonnatan The Barber' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Fredoka:wght@500;600;700&family=Pirata+One&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      // Cualquier botón de reserva por WhatsApp lleva primero al formulario de reserva.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="wa.me"]');
        if (!a) return;
        e.preventDefault();
        const text = new URL(a.href).searchParams.get('text') ?? '';
        const promo = text.match(/promoci[óo]n\s+(.+)$/i)?.[1];
        location.href = '/reservar' + (promo ? '?promo=' + encodeURIComponent(promo) : '');
      });
    </script>
  </body>
</html>
