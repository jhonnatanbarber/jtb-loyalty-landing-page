---
import { location } from '@/data/location';
import { whatsappUrl } from '@/data/contact';

const year = new Date().getFullYear();

const explore = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Promociones', href: '/#promociones' },
  { label: 'Beneficios', href: '/#fidelizacion' },
  { label: 'Galería', href: '/#galeria' },
  { label: 'Ubicación', href: '/#ubicacion' },
];

const linkClass =
  'inline-flex min-h-11 items-center text-base text-cream/75 transition-colors hover:text-gold sm:text-lg';
const heading = 'text-sm font-semibold uppercase tracking-[0.12em] text-brass-light sm:text-base';
---

<footer class="border-t border-brass/30 bg-night px-6 pt-16 font-sans text-cream lg:px-10">
  <div class="mx-auto grid max-w-[1200px] gap-12 pb-12 md:grid-cols-3">
    <!-- Marca -->
    <div>
      <p class="text-2xl font-semibold uppercase tracking-[0.04em]">Jhonnatan The Barber</p>
      <p class="mt-3 text-lg text-cream/75">Tu estilo, nuestra pasión.</p>
      <p class="mt-2 text-base text-cream/60">Barbería en Lima · Desde 2015</p>
    </div>

    <!-- Explora -->
    <nav aria-label="Secciones">
      <p class={heading}>Explora</p>
      <ul class="mt-4">
        {
          explore.map((l) => (
            <li>
              <a href={l.href} class={linkClass}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Contacto -->
    <div>
      <p class={heading}>Visítanos</p>
      <address class="mt-4 not-italic text-base text-cream/75 sm:text-lg">
        {location.address}<br />
        {location.district}, {location.city}
      </address>
      <ul class="mt-2">
        <li>
          <a href={location.mapsUrl} target="_blank" rel="noopener noreferrer" class={`${linkClass} text-gold`}>
            Cómo llegar
          </a>
        </li>
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class={`${linkClass} text-gold`}>
            Reservar por WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Barra legal -->
  <div class="border-t border-brass/20">
    <div
      class="mx-auto flex max-w-[1200px] flex-col items-center justify-between gap-5 py-6 md:flex-row"
    >
      <p class="text-sm text-cream/65 sm:text-base">
        © <span data-year>{year}</span> <span class="font-semibold text-cream">Jhonnatan The Barber</span>. Todos los
        derechos reservados.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-5">
        <a
          href="/libro-de-reclamaciones"
          class="inline-flex min-h-14 items-center gap-3 rounded border border-brass/60 px-4 text-sm font-semibold text-gold transition-colors hover:border-gold hover:bg-brass-light hover:text-night sm:text-base"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-10 w-10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 5.5C4.5 4 8 4 12 6c4-2 7.5-2 10-.5V19c-2.5-1.5-6-1.5-10 .5-4-2-7.5-2-10-.5V5.5zM12 6v13.5"
            ></path>
          </svg>
          Libro de reclamaciones
        </a>
        <a href="/sugerencias" class={`${linkClass} text-sm underline-offset-4 hover:underline sm:text-base`}>
          Sugerencias
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  // El sitio es estático: se actualiza el año con el del navegador del visitante.
  const el = document.querySelector('[data-year]');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
